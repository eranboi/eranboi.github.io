---
import Layout from '../layouts/Layout.astro';
---

<Layout title="about | eranboi">
  <section class="page">
    <div class="hero-header">
      <img src="/eranboi-pfp.png" alt="eranboi" class="avatar" />
      <div class="hero-info">
        <h1>eranboi</h1>
        <p class="tagline">unity game developer</p>
      </div>
    </div>

    <div class="content">
      <p>
        building games and software.
      </p>
      <p>
        focused on creating minimal, functional experiences.
      </p>
    </div>

    <div class="section">
      <h2 class="section-title">stack</h2>
      <ul class="stack">
        <li>languages: c#, c++</li>
        <li>game dev: unity</li>
      </ul>
    </div>

    <div class="section">
      <h2 class="section-title">experience</h2>
      <ul class="stack">
        <li>solo dev @ Feed The Pond</li>
        <li>solo dev @ Immunica</li>
        <li>gameplay programmer @ Blue Goo Games (Space Chef)</li>
        <li>solo dev @ Restless Lands</li>
      </ul>
    </div>

    <div class="section">
      <h2 class="section-title">contact</h2>
      <div class="links">
        <a class="text-link" href="https://github.com/eranboi" target="_blank" rel="noopener">github</a>
        <a class="text-link" href="https://x.com/eranboii" target="_blank" rel="noopener">x</a>
        <a class="text-link" href="mailto:info@eranboigames.com">email</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    max-width: 600px;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
  }

  .hero-info h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }

  .hero-info .tagline {
    color: var(--accent);
    font-size: 0.95rem;
  }

  .content {
    margin-bottom: 3rem;
  }

  .content p {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .section {
    margin-bottom: 2.5rem;
  }

  .stack {
    list-style: none;
  }

  .stack li {
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .stack li::before {
    content: "->";
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }
</style>
