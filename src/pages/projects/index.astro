---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => parseInt(b.data.year) - parseInt(a.data.year));
---

<Layout title="projects | eranboi">
  <section class="page">
    <h1>projects</h1>
    <p class="subtitle">technical work & experiments</p>

    <div class="list">
      {sortedProjects.map((project) => (
        <a href={`/projects/${project.id}`} class="project">
          <div class="header">
            <h2>{project.data.title}</h2>
            <div class="header-right">
              {project.data.outdated && <span class="outdated-badge">outdated</span>}
              <span class="year">{project.data.year}</span>
            </div>
          </div>
          <p class="desc">{project.data.description}</p>
          <div class="tech">
            {project.data.tech.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 3rem;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project {
    display: block;
    padding: 1.5rem;
    border: 1px solid #1a1a1a;
    transition: border-color 0.2s ease;
  }

  .project:hover {
    border-color: #333;
    color: var(--text);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .project h2 {
    font-size: 1rem;
    font-weight: 500;
  }

  .year {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .outdated-badge {
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    color: #ff6b6b;
    border: 1px solid #ff6b6b;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .tech {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: #1a1a1a;
    color: var(--accent);
  }
</style>
