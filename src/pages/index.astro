---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortGames, tagClass } from '../utils/games';

const projects = await getCollection('projects');
const games = await getCollection('games');
const featuredProjects = projects.filter(p => p.data.featured).slice(0, 2);
const featuredGames = sortGames(games.filter(g => g.data.featured)).slice(0, 3);
---

<Layout title="eranboi">
  <section class="hero">
    <h1>eranboi<span class="cursor" aria-hidden="true">_</span></h1>
    <p class="tagline">unity game developer</p>
    <p class="desc">building games & software</p>
  </section>

  <section class="featured">
    <h2 class="section-title">games</h2>
    <div class="game-grid">
      {featuredGames.map((game) => (
        <a href={`/games/${game.id}`} class="game-card">
          <div class="thumb">
            {game.data.cover
              ? <img src={game.data.cover} alt="" loading="lazy" />
              : <span class="thumb-fallback">{game.data.title}</span>}
          </div>
          <div class="game-info">
            <span class="label">{game.data.title}</span>
            <div class="item-tags">
              {game.data.tags.slice(0, 1).map((tag) => (
                <span class={`tag small ${tagClass(tag)}`}>{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
    <a href="/games" class="item see-all">
      <span class="label">see all games</span>
      <span class="arrow">-></span>
    </a>
  </section>

  <section class="featured">
    <h2 class="section-title">projects</h2>
    <div class="items">
      {featuredProjects.map((project) => (
        <a href={`/projects/${project.id}`} class="item">
          <span class="label">{project.data.title}</span>
          <span class="arrow">-></span>
        </a>
      ))}
      <a href="/projects" class="item see-all">
        <span class="label">see all projects</span>
        <span class="arrow">-></span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .tagline {
    color: var(--accent);
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .featured {
    margin-bottom: 3.5rem;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 900px) {
    .game-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .game-grid {
      grid-template-columns: 1fr;
    }
  }

  .game-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.25s var(--ease);
  }

  .game-card:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
    color: var(--text);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .game-card:hover .thumb img {
    transform: scale(1.03);
  }

  /* Games without cover art get a typographic tile instead of an empty box. */
  .thumb-fallback {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    background:
      radial-gradient(ellipse at 30% 20%, var(--accent-soft), transparent 60%),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.06) 1px, transparent 0) 0 0 / 14px 14px;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
  }

  .thumb-fallback::before {
    content: "> ";
    color: var(--accent);
  }

  .game-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .item:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .item.see-all {
    border-style: dashed;
  }

  .item.see-all .label {
    color: var(--text-dim);
  }

  .label {
    font-size: 0.9rem;
  }

  .item-tags {
    display: flex;
    gap: 0.5rem;
  }

  .item .arrow {
    color: var(--text-dim);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .item:hover .arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
</style>
