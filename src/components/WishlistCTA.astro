---
interface Props {
  title: string;
  steamUrl: string;
  /** Wide art with its subject on the left; the copy sits over the right side. */
  banner?: string;
  /** Shown instead of `banner` on narrow screens, where the art sits above the copy (e.g. a logo capsule). */
  bannerMobile?: string;
}

const { title, steamUrl, banner, bannerMobile } = Astro.props;
---

<a href={steamUrl} target="_blank" rel="noopener" class:list={['wishlist', banner && 'has-banner']}>
  {banner && (
    <picture>
      {bannerMobile && <source media="(max-width: 640px)" srcset={bannerMobile} />}
      <img class="art" src={banner} alt="" loading="lazy" />
    </picture>
  )}

  <div class="body">
    <p class="eyebrow">coming soon to steam</p>
    <h2>wishlist {title.toLowerCase()}</h2>
    <p class="pitch">
      Wishlists are the best way to support a solo dev. Steam will let you know the moment it launches.
    </p>
    <span class="button">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
      </svg>
      wishlist on steam
      <span class="arrow" aria-hidden="true">-></span>
    </span>
  </div>
</a>

<style>
  .wishlist {
    position: relative;
    display: flex;
    justify-content: flex-end;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
    overflow: hidden;
    isolation: isolate;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.3s ease;
  }

  .wishlist.has-banner {
    aspect-ratio: 1200 / 388;
    min-height: 240px;
  }

  .wishlist:hover {
    color: var(--text);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-soft), 0 12px 40px -18px rgba(0, 255, 136, 0.35);
  }

  .art {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    transition: transform 0.6s var(--ease);
  }

  .wishlist:hover .art {
    transform: scale(1.03);
  }

  /* Darken the right side so the copy reads over the art. */
  .has-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      transparent 30%,
      rgba(10, 10, 10, 0.72) 55%,
      rgba(10, 10, 10, 0.92) 100%
    );
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 1.5rem 1.75rem;
  }

  .has-banner .body {
    width: min(48%, 380px);
  }

  .eyebrow {
    color: var(--tag-soon);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 0.4rem;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }

  .pitch {
    color: #b5b5b5;
    font-size: 0.85rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #000;
    background: var(--accent);
    padding: 0.65rem 1.1rem;
    border-radius: 2px;
    transition: filter 0.2s ease;
  }

  .wishlist:hover .button {
    filter: brightness(1.1);
  }

  .arrow {
    transition: transform 0.25s var(--ease);
  }

  .wishlist:hover .arrow {
    transform: translateX(3px);
  }

  /* Narrow screens: art on top, copy below. */
  @media (max-width: 640px) {
    .wishlist.has-banner {
      flex-direction: column;
      aspect-ratio: auto;
      min-height: 0;
    }

    .art {
      position: static;
      aspect-ratio: 920 / 430;
      height: auto;
    }

    .has-banner::before {
      display: none;
    }

    .has-banner .body {
      width: auto;
      padding: 1.25rem;
    }

    .button {
      align-self: stretch;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art,
    .arrow {
      transition: none;
    }
  }
</style>
